# Required for IA chat (Anthropic Claude)
ANTHROPIC_API_KEY=

# Model id (change if Anthropic renames; see https://docs.anthropic.com/en/docs/about-claude/models)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

PORT=8780

# Opcional: mismas URLs que wrangler.toml — agregá CORE_API_TOKEN para /clients/auth-audit y lecturas Bearer
CORE_V2_URL=https://onbox-core-v2.soporte-a90.workers.dev
ONBOX_CORE_URL=https://onbox-core.soporte-a90.workers.dev
CORE_API_TOKEN=

# Gastronomía — proxy (Selenia /ops/overview y comando health-check)
GASTRONOMIA_PROXY_URL=https://logistica-gastronomica-proxy.soporte-a90.workers.dev

# Opcional: JSON [{ "id","label","url","method"?,"headers"? }] para GET /ops/audit (probes extra), ej. admin Pages
# SELENIA_AUDIT_EXTRA=[{"id":"gastro-admin-pages","label":"Gastronomía admin (Pages)","url":"https://onbox-admin.pages.dev/"}]

# Gastronomía — workflow_dispatch (comandos gastronomia:run-ci y sistemas:ci-gastro)
# SELENIA_ACTIONS_REPO=owner/onbox-universe
# SELENIA_GASTRO_WORKFLOW=gastronomia-smoke.yml
# SELENIA_ACTIONS_REF=master
# Payload opcional en POST body: { "action":"run-ci","payload":{"run_smoke":true,"worker_url":"https://..."} }

# Optional: proxy module commands to a real OnBox gateway (future)
# SELENIA_GATEWAY_URL=http://127.0.0.1:4000

# Optional: al escribir APROBADO_SELENIA en el chat → repository_dispatch (mismo repo que GITHUB_REPO)
# PAT con permiso Actions (workflow) en SELENIA_ACTIONS_REPO además del scope que uses para repository_dispatch
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_DISPATCH_EVENT=selenia_approved
# Si está seteado, el Worker exige header X-Selenia-Dispatch-Key o body.dispatchKey igual
SELENIA_DISPATCH_KEY=

# Opcional: si está seteado, GET/POST /ai/knowledge, /ai/roadmap, /ai/insights, merge y promote exigen header X-Selenia-Internal-Key (mismo nombre en Worker vía wrangler secret put SELENIA_INTERNAL_KEY)
# SELENIA_INTERNAL_KEY=

# Chat: frases de aprobación (el usuario las escribe en el mensaje)
# APROBADO_SELENIA — disparar CI/dispatch según README
# APROBADO_DATOS — permitir tool core_v2_inventory_write (POST Core v2 inventario) desde Selenia
# APROBADO_MEMORIA — promote de insights (POST /ai/insights/.../promote)
