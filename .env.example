# Required for IA chat (Anthropic Claude)
ANTHROPIC_API_KEY=

# Model id (change if Anthropic renames; see https://docs.anthropic.com/en/docs/about-claude/models)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

PORT=8780

# Opcional: mismas URLs que wrangler.toml — agregá CORE_API_TOKEN para /clients/auth-audit y lecturas Bearer
CORE_V2_URL=https://onbox-core-v2.soporte-a90.workers.dev
ONBOX_CORE_URL=https://onbox-core.soporte-a90.workers.dev
CORE_API_TOKEN=

# Gastronomía — proxy (Selenia /ops/overview y comando health-check)
GASTRONOMIA_PROXY_URL=https://logistica-gastronomica-proxy.soporte-a90.workers.dev

# Opcional: JSON [{ "id","label","url","method"?,"headers"? }] para GET /ops/audit (probes extra)
# SELENIA_AUDIT_EXTRA=

# Optional: proxy module commands to a real OnBox gateway (future)
# SELENIA_GATEWAY_URL=http://127.0.0.1:4000

# Optional: al escribir APROBADO_SELENIA en el chat → repository_dispatch (mismo repo que GITHUB_REPO)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_DISPATCH_EVENT=selenia_approved
# Si está seteado, el Worker exige header X-Selenia-Dispatch-Key o body.dispatchKey igual
SELENIA_DISPATCH_KEY=
